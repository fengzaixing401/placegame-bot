# 复制为 .env 后填写。.env 已在 .gitignore 中,不要提交。
# 账号凭据不在这里配置 —— 通过 POST /accounts 写入,加密存 SQLite。

# 【必填】主密钥,用于加密账号凭据。生成:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# 丢失后已存账号无法解密,务必备份。
PLACEGAME_MASTER_KEY_B64=

# 【必填】调用本服务 REST 接口的 Bearer 令牌(agent 用它鉴权)。生成:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# 注意:这里只是引导值。一旦在 WebUI 里轮换过令牌,生效值就以数据库为准,
# 本文件里的旧值即刻失效(GET /health/ready 的 apiTokenSource 会显示 db)。
PLACEGAME_API_TOKEN=

# 会话 cookie 是否带 Secure 属性。默认 true(生产走 HTTPS 反代)。
# 只有直连明文 HTTP 调试时才需要改成 false,否则浏览器不回传 cookie,登录会一直失败。
PLACEGAME_WEB_SECURE_COOKIE=true

# WebUI 登录状态有效期(小时)
PLACEGAME_WEB_SESSION_HOURS=12

# 容器内监听地址与端口(改这个要同步改 compose 的容器侧端口,一般不用动)
PLACEGAME_HOST=0.0.0.0
PLACEGAME_PORT=8080

# 宿主机映射端口(只绑 127.0.0.1)。18080 已被 placegame-mcp 占用
PLACEGAME_HOST_PORT=18090

# SQLite 路径(容器内建议挂卷到 /data)
PLACEGAME_DB_PATH=/data/placegame.db

# 数据目录。只在没设 PLACEGAME_DB_PATH 时用来推导库路径(<dataDir>/accounts.db)
PLACEGAME_DATA_DIR=/data

# 全局默认规则的 JSON 文件路径。留空表示用代码内置默认;
# 账号级规则仍以 PUT /accounts/:label/rules 为准,优先级更高
PLACEGAME_RULES_FILE=

# 调用游戏服务端的单请求超时(毫秒)
PLACEGAME_REQUEST_TIMEOUT_MS=15000

# 是否启用定时排程(false 时只提供 REST,由外部触发)
PLACEGAME_SCHEDULER=true

# 排程时区。游戏世界首领窗口按北京时间,不要改
PLACEGAME_TZ=Asia/Shanghai

# 游戏服务端地址
PLACEGAME_BASE_URL=https://api.placegame.cn
